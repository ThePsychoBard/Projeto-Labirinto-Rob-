<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="labirinto.view.TelaConfiguracaoController"
            styleClass="tela-config"
            prefWidth="1200" prefHeight="800">

    <top>
        <VBox spacing="10" alignment="CENTER">
            <padding><Insets top="15" bottom="15"/></padding>
            <Label text="Configurar Labirinto" styleClass="titulo"/>
            <Label fx:id="lblModo" text="Modo: Adicionar Obstáculos" styleClass="subtitulo"/>
            <HBox spacing="10" alignment="CENTER">
                <Button text="Obstáculos" onAction="#selecionarModoObstaculo" styleClass="botao-secundario"/>
                <Button text="Início"     onAction="#selecionarModoInicio"     styleClass="botao-modo-inicio"/>
                <Button text="Fim"        onAction="#selecionarModoFim"        styleClass="botao-modo-fim"/>
                <Button text="Limpar Tudo" onAction="#limparTudo"              styleClass="botao-secundario"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true"
                    hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED"
                    styleClass="scroll-grade">
            <GridPane fx:id="grade" alignment="CENTER" hgap="2" vgap="2">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            </GridPane>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="20" alignment="CENTER">
            <padding><Insets top="15" bottom="20"/></padding>
            <Button text="VOLTAR"  onAction="#voltar"   styleClass="botao-secundario"/>
            <Button text="RESOLVER" onAction="#resolver" styleClass="botao-primario"/>
        </HBox>
    </bottom>
</BorderPane>